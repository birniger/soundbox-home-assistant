+async def async_register_sentence_pack(hass: HomeAssistant, sentence_dir: Path) -> None:
+    """Register sentence YAML shipped by an installed integration.
+
+    The integration explicitly opts in from ``async_setup``. Its phrases stay
+    distinct from user-managed ``custom_sentences``, and no integration needs
+    to write to the user's configuration directory.
+    """
+    agent = get_agent_manager(hass).default_agent
+    if not isinstance(agent, DefaultAgent):
+        raise TypeError("The default Home Assistant conversation agent is unavailable")
+    await agent.async_register_sentence_pack(sentence_dir)
+
