+@pytest.mark.usefixtures("init_components")
+async def test_registered_sentence_pack(hass: HomeAssistant, tmp_path: Path) -> None:
+    """An integration can ship grammar without writing user configuration."""
+    sentence_dir = tmp_path / "sentences" / "en"
+    sentence_dir.mkdir(parents=True)
+    (sentence_dir / "order.yaml").write_text(
+        """language: en
+intents:
+  OrderBeer:
+    data:
+      - sentences:
+          - order a bundled {beer_style}
+lists:
+  beer_style:
+    values:
+      - stout
+""",
+        encoding="utf-8",
+    )
+    intent.async_register(hass, OrderBeerIntentHandler())
+    await conversation.async_register_sentence_pack(hass, sentence_dir.parent)
+
+    result = await conversation.async_converse(
+        hass, "order a bundled stout", None, Context(), language="en"
+    )
+    assert result.response.response_type is intent.IntentResponseType.ACTION_DONE
+    assert result.response.speech["plain"]["speech"] == "You ordered a stout"
+
